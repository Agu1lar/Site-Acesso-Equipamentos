# Copie para .env.local (desenvolvimento) ou configure no Vercel (preview/produção)
# Nunca commite arquivos .env com valores reais.

# --- Obrigatórias (build) ---
DASHBOARD_SESSION_SECRET=change-me-to-a-random-string-with-32-chars-min
# IPs públicos autorizados a acessar login e painel, separados por vírgula.
# DASHBOARD_ALLOWED_IPS=203.0.113.10,198.51.100.20
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Produção (domínio oficial):
# NEXT_PUBLIC_APP_URL=https://acessoequipamentos.com.br
NEXT_PUBLIC_SENTRY_DISABLED=true

# --- Opcionais ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Acesso Equipamentos <onboarding@resend.dev>
# LEADS_NOTIFY_EMAIL=comercial@acessoequipamentos.com.br,outro@...
# (comercial@acessoequipamentos.com.br sempre recebe; liste extras separados por vírgula)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...
# Google Ads tag (conta AW-…) — carrega junto do GA4 após consentimento
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-11323862073
# Rótulos de conversão (Ads → Metas → Conversões → tag). Formato: AW-…/rótulo
# Ação única preferida para WhatsApp, orçamento e telefone.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_CONTACT=AW-11323862073/zzzzzz
# Legado: usados somente se a variável CONTACT não existir.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LEAD=AW-11323862073/xxxxxx
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_WHATSAPP=AW-11323862073/yyyyyy
# Google Ads API — upload offline de conversão WhatsApp com gclid/gbraid/wbraid
# Opcional e legado desde 09/09/2026; servidores atuais ignoram esse header.
# GOOGLE_ADS_DEVELOPER_TOKEN=...
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210
# GOOGLE_ADS_CLIENT_ID=...
# GOOGLE_ADS_CLIENT_SECRET=...
# GOOGLE_ADS_REFRESH_TOKEN=... # escopos adwords + datamanager
# GOOGLE_ADS_OFFLINE_CONVERSION_ACTION_ID=123456789
# GOOGLE_ADS_OFFLINE_CONVERSION_ACTION_RESOURCE_NAME=customers/1234567890/conversionActions/123456789
# Ação UPLOAD_CLICKS de contato confirmado: WhatsApp aberto ou resposta recebida.
# GOOGLE_ADS_CONFIRMED_CONTACT_CONVERSION_ACTION_ID=123456791
# GOOGLE_ADS_CONFIRMED_CONTACT_CONVERSION_ACTION_RESOURCE_NAME=customers/1234567890/conversionActions/123456791
# Ação UPLOAD_CLICKS separada, enviada quando a equipe marca o lead como qualificado.
# GOOGLE_ADS_QUALIFIED_LEAD_CONVERSION_ACTION_ID=123456790
# GOOGLE_ADS_QUALIFIED_LEAD_CONVERSION_ACTION_RESOURCE_NAME=customers/1234567890/conversionActions/123456790
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ChatPro webhook (marque lead quando o cliente responde no WhatsApp)
# Gere um segredo longo e use a mesma URL no painel ChatPro:
# https://acessoequipamentos.com.br/api/webhooks/chatpro?token=SEU_SECRETO
# CHATPRO_WEBHOOK_SECRET=um-segredo-com-pelo-menos-16-caracteres

# API privada para app externo de qualidade comercial / novas campanhas
# Use como: Authorization: Bearer SEU_TOKEN
# INTERNAL_API_SECRET=um-segredo-forte-com-pelo-menos-24-caracteres
# CRON_SECRET=um-segredo-aleatorio-com-pelo-menos-16-caracteres
# Claude API (somente servidor; configure na Vercel)
# Claude — texto do blog (obrigatório para gerar artigos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_STRONG_MODEL=claude-sonnet-5
